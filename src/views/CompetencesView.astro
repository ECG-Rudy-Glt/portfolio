---
import Layout from "../layouts/Layout.astro";
import { enProject } from "../i18n/projects-en";
import { buildDomains } from "../data/domains";
import type { Lang } from "../i18n/ui";
const { lang = "fr" } = Astro.props as { lang?: Lang };
const en = lang === "en";
import SkillDomains from "../components/SkillDomains";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

// Domaines de compétence : chaque domaine regroupe des étiquettes et des outils ; il est « démontré » par les projets qui en mobilisent au moins un.
const total = projects.length;
const domains = buildDomains(projects, en);

const softSkillsEn = [
  { title: "Project management & coordination", detail: "Cross-team project tracking at Cloud Temple (planning, coordination between teams) and writing the requirements and managing the budget for the SUPINFO lab.", projects: [{ slug: "cloud-temple", title: "Cloud Temple work-study" }, { slug: "supinfo-lab", title: "SUPINFO Lab" }] },
  { title: "Initiative & autonomy", detail: "The SUPINFO lab started as a personal initiative, carried end to end without anyone asking. The homelab is designed and run solo.", projects: [{ slug: "supinfo-lab", title: "SUPINFO Lab" }, { slug: "homelab", title: "Homelab" }] },
  { title: "Teamwork", detail: "Contributing to group projects with a clear split of roles: SUPCHAT and SUPFile with a full team, 4ARCL in a pair on architecture design.", projects: [{ slug: "supchat", title: "SUPCHAT" }, { slug: "supfile", title: "SUPFile" }, { slug: "4arcl", title: "4ARCL" }] },
  { title: "Rigour & consistent results", detail: "BTS SIO passed with 15.5/20, then the end-of-year projects at SUPINFO: SUPCHAT in the 3rd year and SUPFile in the 4th year.", projects: [{ slug: "bts-sio", title: "BTS SIO" }] },
  { title: "Teaching & knowledge sharing", detail: "The SUPINFO lab was designed from the start so that other students can practise infrastructure, not just for my own use.", projects: [{ slug: "supinfo-lab", title: "SUPINFO Lab" }] },
  { title: "Synthesis & architectural thinking", detail: "Quickly grasping what is at stake in a subject rather than rushing into execution: put into practice on 4ARCL (design before code) and on the automation of audits at Cloud Temple.", projects: [{ slug: "4arcl", title: "4ARCL" }, { slug: "cloud-temple", title: "Cloud Temple work-study" }] },
];
const softSkillsFr = [
  {
    title: "Gestion de projet & pilotage",
    detail:
      "Suivi de projets transverses chez Cloud Temple (planification, coordination entre équipes) et rédaction du cahier des charges / gestion du budget pour le lab SUPINFO.",
    projects: [
      { slug: "cloud-temple", title: "Alternance Cloud Temple" },
      { slug: "supinfo-lab", title: "SUPINFO Lab" },
    ],
  },
  {
    title: "Initiative & autonomie",
    detail:
      "Le lab SUPINFO est né d'une initiative personnelle, portée de bout en bout sans qu'on me le demande. Le homelab est conçu et exploité en solo.",
    projects: [
      { slug: "supinfo-lab", title: "SUPINFO Lab" },
      { slug: "homelab", title: "Homelab" },
    ],
  },
  {
    title: "Travail en équipe",
    detail:
      "Contribution à des projets de groupe avec répartition des rôles : SUPCHAT et SUPFile en équipe complète, 4ARCL en binôme sur la conception d'architecture.",
    projects: [
      { slug: "supchat", title: "SUPCHAT" },
      { slug: "supfile", title: "SUPFile" },
      { slug: "4arcl", title: "4ARCL" },
    ],
  },
  {
    title: "Rigueur & constance des résultats",
    detail:
      "BTS SIO validé avec 15,5/20, puis les projets de fin d'année à SUPINFO : SUPCHAT en 3e année et SUPFile en 4e année.",
    projects: [{ slug: "bts-sio", title: "BTS SIO" }],
  },
  {
    title: "Pédagogie & transmission",
    detail:
      "Le lab SUPINFO a été pensé dès le départ pour permettre à d'autres étudiants de pratiquer l'infrastructure, pas seulement pour mon usage personnel.",
    projects: [{ slug: "supinfo-lab", title: "SUPINFO Lab" }],
  },
  {
    title: "Synthèse & vision architecturale",
    detail:
      "Comprendre vite les enjeux et les tenants et aboutissants d'un sujet, plutôt que de foncer dans l'exécution - une approche mise en pratique sur 4ARCL (conception avant code) et sur l'automatisation des audits chez Cloud Temple.",
    projects: [
      { slug: "4arcl", title: "4ARCL" },
      { slug: "cloud-temple", title: "Alternance Cloud Temple" },
    ],
  },
];
const softSkills = en ? softSkillsEn : softSkillsFr;
---

<Layout
  lang={lang}
  alt={en ? "/competences/" : "/en/competences/"}
  title={en ? "Skills - Rudy Gault" : "Compétences - Rudy Gault"}
  description={en ? "Rudy Gault's technical skills (infrastructure, DevOps, IaC, security, development) linked to the projects that demonstrate them, and soft skills illustrated with concrete situations." : "Compétences techniques de Rudy Gault (infrastructure, DevOps, IaC, sécurité, développement) reliées aux projets qui les démontrent, et compétences humaines illustrées."}
>
  <h1 class="mb-2 text-3xl font-bold text-[var(--fg)]">{en ? "Skills" : "Compétences"}</h1>
  <p class="mb-10 max-w-2xl text-[var(--fg-muted)]">
    {en ? "For each technical area: how many projects put it into practice and in what setting (professional, personal, school). Click an area to see the tools and projects. Soft skills are illustrated further down with concrete situations." : "Pour chaque domaine technique : dans combien de projets il est mis en pratique et dans quel cadre (entreprise, projets personnels, école). Cliquez un domaine pour voir les outils et les projets. Les compétences humaines sont illustrées plus bas par des situations concrètes."}
  </p>

  <details class="group" open>
    <summary class="mb-4 flex cursor-pointer list-none items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[var(--accent)]">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="shrink-0 transition-transform group-open:rotate-90"
      >
        <path d="M9 18l6-6-6-6" />
      </svg>
      {en ? "Technical" : "Techniques"}
    </summary>
    <SkillDomains client:visible domains={domains} total={total} lang={lang} />
  </details>

  <h2 class="mb-4 mt-16 text-sm font-semibold uppercase tracking-wide text-[var(--relevance-pertinent)]">
    {en ? "Soft skills" : "Savoir-être"}
  </h2>
  <div class="grid gap-4 sm:grid-cols-2">
    {softSkills.map((skill) => (
      <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5">
        <h3 class="mb-2 font-medium text-[var(--fg)]">{skill.title}</h3>
        <p class="mb-3 text-sm text-[var(--fg-muted)]">{skill.detail}</p>
        <div class="flex flex-wrap gap-2">
          {skill.projects.map((p) => (
            <a
              href={`/projets/${p.slug}/`}
              class="rounded-full bg-[var(--bg)] px-3 py-1 text-xs text-[var(--fg-muted)] ring-1 ring-[var(--border)] transition-colors hover:text-[var(--accent)]"
            >
              {p.title}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</Layout>
