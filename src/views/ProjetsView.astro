---
import Layout from "../layouts/Layout.astro";
import { enProject } from "../i18n/projects-en";
import type { Lang } from "../i18n/ui";
const { lang = "fr" } = Astro.props as { lang?: Lang };
const en = lang === "en";
const view = (p: { id: string; data: { title: string; summary: string; period: string } }) => (en ? enProject(p.id, p.data) : p.data);
import ProjectCard from "../components/ProjectCard.astro";
import ProjectFilter from "../components/ProjectFilter";
import LiveSites from "../components/LiveSites.astro";
import { getCollection } from "astro:content";

const relevanceWeight = { majeur: 0, pertinent: 1, secondaire: 2 } as const;

const sortByRelevance = (a: Awaited<ReturnType<typeof getCollection<"projects">>>[number], b: typeof a) => {
  const relevanceDiff = relevanceWeight[a.data.relevance] - relevanceWeight[b.data.relevance];
  return relevanceDiff !== 0 ? relevanceDiff : a.data.order - b.data.order;
};

const allProjects = await getCollection("projects");

const isMinorSchoolProject = (project: (typeof allProjects)[number]) =>
  project.data.category === "ecole" && project.data.relevance === "secondaire";

const projects = allProjects.filter((p) => !isMinorSchoolProject(p)).sort(sortByRelevance);
const minorSchoolProjects = allProjects.filter(isMinorSchoolProject).sort(sortByRelevance);
---

<Layout
  lang={lang}
  alt={en ? "/projets/" : "/en/projets/"}
  title={en ? "Projects - Rudy Gault" : "Projets - Rudy Gault"}
  description={en ? "Rudy Gault's projects ranked by relevance: self-hosted homelab as code, DevOps toolbox, Cloud Temple work-study, SUPINFO projects (Kubernetes, Docker, cloud)." : "Projets de Rudy Gault classés par pertinence : homelab self-hosted en IaC, suite d'outils DevOps, alternance Cloud Temple, projets SUPINFO (Kubernetes, Docker, cloud)."}
>
  <h1 class="mb-2 text-3xl font-bold text-[var(--fg)]">{en ? "Projects" : "Projets"}</h1>
  <p class="mb-4 text-[var(--fg-muted)]">
    {en ? "Personal projects, school projects and my work-study assignment, ranked by relevance. The detailed write-ups are in French." : "Projets personnels, projets école et mission d'alternance, classés par pertinence."}
  </p>

  <div class="mb-8 flex flex-wrap gap-4 text-xs text-[var(--fg-muted)]">
    <span class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-full" style="background-color: var(--relevance-majeur)"></span>
      {en ? "Major project" : "Projet majeur"}
    </span>
    <span class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-full" style="background-color: var(--relevance-pertinent)"></span>
      {en ? "Relevant" : "Pertinent"}
    </span>
    <span class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-full" style="background-color: var(--relevance-secondaire)"></span>
      {en ? "Minor" : "Secondaire"}
    </span>
  </div>

  <LiveSites lang={lang} title={en ? "Try them right now" : "À essayer tout de suite"} note={en ? "Live sites and demos, no account needed" : "Sites et démos en ligne, sans compte"} />

  <ProjectFilter client:load lang={lang} />

  <div class="grid gap-6 sm:grid-cols-2">
    {projects.map((project) => (
      <ProjectCard
        slug={project.id}
        lang={lang}
        title={view(project).title}
        summary={view(project).summary}
        period={view(project).period}
        tags={project.data.tags}
        category={project.data.category}
        relevance={project.data.relevance}
      />
    ))}
  </div>

  {minorSchoolProjects.length > 0 && (
    <details class="mt-10 rounded-xl border border-[var(--border)]">
      <summary class="cursor-pointer select-none px-6 py-4 text-sm font-medium text-[var(--fg-muted)] hover:text-[var(--fg)]">
        {en ? "Other school projects" : "Autres projets école"} ({minorSchoolProjects.length})
      </summary>
      <div class="grid gap-6 p-6 pt-0 sm:grid-cols-2">
        {minorSchoolProjects.map((project) => (
          <ProjectCard
            slug={project.id}
            lang={lang}
            title={view(project).title}
            summary={view(project).summary}
            period={view(project).period}
            tags={project.data.tags}
            category={project.data.category}
            relevance={project.data.relevance}
          />
        ))}
      </div>
    </details>
  )}
</Layout>
