---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n/ui";
const { lang = "fr" } = Astro.props as { lang?: Lang };
const en = lang === "en";

const alternanceFr = [
  {
    period: "2022 - 2024",
    title: "Alternance chez Ethan Consulting",
    detail: "Développeur en alternance pendant le BTS SIO SLAM (ENSITECH). Premiers pas en développement logiciel : regex, manipulation du DOM, web scraping, modélisation MERISE.",
    href: "/projets/ethan-consulting/",
  },
  {
    period: "2024 - sept. 2027 (prévu)",
    title: "Alternance chez Cloud Temple",
    detail: "Infrastructure & automatisation : virtualisation VMware, Ansible, CI/CD GitLab, monitoring d'infrastructures critiques. Évolution vers le suivi de projets transverses.",
    href: "/projets/cloud-temple/",
  },
];

const ecoleFr = [
  {
    period: "2020 - 2021",
    title: "L1 Droit - Faculté de Tours",
    detail: "Une première année en plein Covid qui a vite montré que ce n'était pas la bonne voie.",
    href: "/projets/bts-sio/",
  },
  {
    period: "2021 - 2022",
    title: "Saisie informatique",
    detail: "Une année de transition avant la réorientation vers le développement.",
    href: "/projets/bts-sio/",
  },
  {
    period: "2022 - 2024",
    title: "BTS SIO SLAM",
    detail: "Fondamentaux du développement et des bases de données. Diplômé avec 15,5/20. Certifications AWS Cloud Practitioner et DevOps en auto-formation.",
    href: "/projets/bts-sio/",
  },
  {
    period: "SUPINFO - 3e année",
    title: "1er niveau campus SUPINFO - SUPCHAT",
    detail: "Plateforme de chat temps réel multi-plateforme avec IA Mistral intégrée, en équipe.",
    href: "/projets/supchat/",
  },
  {
    period: "SUPINFO - 4e année",
    title: "2e niveau campus de Tours - SUPFile",
    detail: "Stockage cloud souverain avec chiffrement de bout en bout et IA documentaire embarquée, en équipe.",
    href: "/projets/supfile/",
  },
  {
    period: "SUPINFO - 5e année (en cours)",
    title: "Dernière année de master",
    detail: "Dernière année du cursus, toujours en alternance chez Cloud Temple, jusqu'à la fin de cursus prévue en septembre 2027.",
    href: "/projets/supinfo-formation/",
  },
];

const persoFr = [
  {
    period: "2025",
    title: "Delivery Suite - offre de services DevOps",
    detail: "Construction d'une suite d'outils DevOps packagés (hardening, CI/CD, audit sécurité), en parallèle de l'alternance. Le projet commercial associé est mis en pause le temps de finaliser un site dédié à mon activité de freelance - un projet distinct, qui pourra s'appuyer sur cette suite comme base technique.",
    href: "/projets/ops-delivery-suite/",
  },
  {
    period: "2026 - en cours",
    title: "Homelab",
    detail: "Infrastructure personnelle self-hosted : réseau segmenté, PKI interne, secrets centralisés, observabilité - pilotée en Infrastructure as Code.",
    href: "/projets/homelab/",
  },
  {
    period: "2026 - en cours",
    title: "Initiative - montage d'un lab pédagogique SUPINFO",
    detail: "Cahier des charges, gestion du budget, choix de l'équipement : un projet porté de bout en bout, en plus du cursus.",
    href: "/projets/supinfo-lab/",
  },
];

const alternanceEn = [
  { period: "2022 - 2024", title: "Work-study at Ethan Consulting", detail: "Work-study developer during the BTS SIO SLAM (ENSITECH). First steps in software development: regex, DOM manipulation, web scraping, MERISE modelling.", href: "/projets/ethan-consulting/" },
  { period: "2024 - Sept. 2027 (planned)", title: "Work-study at Cloud Temple", detail: "Infrastructure & automation: VMware virtualisation, Ansible, GitLab CI/CD, monitoring of critical infrastructure. Grew into cross-team project tracking.", href: "/projets/cloud-temple/" },
];

const ecoleEn = [
  { period: "2020 - 2021", title: "First year of Law - University of Tours", detail: "A first year in the middle of Covid that quickly showed it was not the right path.", href: "/projets/bts-sio/" },
  { period: "2021 - 2022", title: "Data entry course", detail: "A transition year before switching to software development.", href: "/projets/bts-sio/" },
  { period: "2022 - 2024", title: "BTS SIO SLAM", detail: "Fundamentals of development and databases. Graduated with 15.5/20. AWS Cloud Practitioner and DevOps certifications through self-study.", href: "/projets/bts-sio/" },
  { period: "SUPINFO - 3rd year", title: "1st at campus level - SUPCHAT", detail: "Cross-platform real-time chat platform with built-in Mistral AI, built as a team.", href: "/projets/supchat/" },
  { period: "SUPINFO - 4th year", title: "2nd at campus level (Tours) - SUPFile", detail: "Sovereign cloud storage with end-to-end encryption and an embedded document AI, built as a team.", href: "/projets/supfile/" },
  { period: "SUPINFO - 5th year (ongoing)", title: "Final year of the master's programme", detail: "Last year of the curriculum, still work-study at Cloud Temple, until the planned end of studies in September 2027.", href: "/projets/supinfo-formation/" },
];

const persoEn = [
  { period: "2025", title: "Delivery Suite - DevOps service offering", detail: "A suite of packaged DevOps tools (hardening, CI/CD, security audit) built alongside the work-study. The related commercial project is on hold while I finish a dedicated site for my freelance activity, a separate project that can build on it.", href: "/projets/ops-delivery-suite/" },
  { period: "2026 - ongoing", title: "Homelab", detail: "Self-hosted personal infrastructure: segmented network, internal PKI, centralised secrets, observability, all driven as Infrastructure as Code.", href: "/projets/homelab/" },
  { period: "2026 - ongoing", title: "Initiative - building a SUPINFO teaching lab", detail: "Requirements, budget, equipment choices: a project carried end to end, on top of the curriculum.", href: "/projets/supinfo-lab/" },
];

const alternance = en ? alternanceEn : alternanceFr;
const ecole = en ? ecoleEn : ecoleFr;
const perso = en ? persoEn : persoFr;

const tracks = [
  { title: en ? "Work-study" : "Alternance", color: "var(--accent)", items: alternance },
  { title: en ? "School" : "École", color: "var(--relevance-pertinent)", items: ecole },
  { title: en ? "Personal projects" : "Projets perso", color: "var(--skill-4)", items: perso },
];
---

<Layout
  lang={lang}
  alt={en ? "/parcours/" : "/en/parcours/"}
  title={en ? "Journey - Rudy Gault" : "Parcours - Rudy Gault"}
  description={en ? "Rudy Gault's journey since the BTS SIO: work-study at Ethan Consulting and Cloud Temple, the SUPINFO curriculum and personal initiatives, on three parallel tracks." : "Parcours de Rudy Gault depuis le BTS SIO : alternances (Ethan Consulting, Cloud Temple), cursus SUPINFO et initiatives personnelles, sur trois fils menés en parallèle."}
>
  <h1 class="mb-2 text-3xl font-bold text-[var(--fg)]">{en ? "My journey" : "Mon parcours"}</h1>
  <p class="mb-12 max-w-2xl text-[var(--fg-muted)]">
    {en ? "Three threads running in parallel since the BTS SIO: work-study in industry, the school track, and personal initiatives on the side." : "Trois fils conducteurs qui avancent en parallèle depuis le BTS SIO : l'alternance en entreprise, le parcours école, et les initiatives personnelles à côté."}
  </p>

  <div class="grid gap-10 sm:grid-cols-3">
    {tracks.map((track) => (
      <section>
        <h2 class="mb-6 text-sm font-semibold uppercase tracking-wide" style={`color: ${track.color}`}>
          {track.title}
        </h2>
        <ol class="space-y-10 border-l border-[var(--border)] pl-8">
          {track.items.map((step) => (
            <li class="relative">
              <span class="absolute -left-[37px] top-1 h-3 w-3 rounded-full" style={`background-color: ${track.color}`}></span>
              <p class="text-xs text-[var(--fg-muted)]">{step.period}</p>
              <a href={step.href} hreflang="fr" class="mt-1 block text-lg font-medium text-[var(--fg)] hover:text-[var(--accent)]">
                {step.title}
              </a>
              <p class="mt-1 text-sm text-[var(--fg-muted)]">{step.detail}</p>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <section class="mt-16 border-t border-[var(--border)] pt-8">
    <h2 class="mb-3 text-xl font-semibold text-[var(--fg)]">{en ? "Beyond the technical side" : "Au-delà de la technique"}</h2>
    {en ? (<>
    <p class="max-w-2xl text-[var(--fg-muted)]">
      My work-study at Cloud Temple also let me follow cross-team projects (planning, coordination between teams), just as the SUPINFO lab initiative meant managing a budget and writing requirements, and the Delivery Suite venture taught me to balance my workload across several commitments. A clear appetite for growing into roles that combine technical expertise with project leadership.
    </p>
    <p class="mt-4 max-w-2xl text-[var(--fg-muted)]">
      Day to day: the ability to synthesise quickly, to grasp what is at stake in a subject, an architectural rather than purely executing mindset, and a reflex for spotting where automation saves the most time.
    </p></>) : (<>
    <p class="max-w-2xl text-[var(--fg-muted)]">
      L'alternance chez Cloud Temple a aussi été l'occasion de suivre des projets transverses
      (planification, coordination entre équipes), tout comme l'initiative du lab SUPINFO a
      demandé de gérer un budget et un cahier des charges, et la tentative entrepreneuriale
      Delivery Suite d'apprendre à arbitrer sa charge de travail entre plusieurs engagements. Une appétence affirmée pour évoluer
      vers des responsabilités combinant expertise technique et pilotage de projet.
    </p>
    <p class="mt-4 max-w-2xl text-[var(--fg-muted)]">
      Au quotidien : une capacité à synthétiser vite, à comprendre rapidement les enjeux et les
      tenants et aboutissants d'un sujet, une vision architecturale plutôt que purement
      exécutante, et un réflexe à repérer où l'automatisation fait gagner le plus de temps.
    </p></>)}
  </section>
</Layout>
