---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import Quiz from "../../components/Quiz.tsx";

const quizPools = import.meta.glob("../../data/quizzes/*.ts", { eager: true }) as Record<
  string,
  { default?: unknown; [key: string]: unknown }
>;

function getQuizQuestions(key?: string) {
  if (!key) return null;
  const mod = quizPools[`../../data/quizzes/${key}.ts`];
  if (!mod) return null;
  // Le module exporte `<key>Questions` (ex. `azQuestions` pour az-104) - on prend
  // le premier export nommé qui est un tableau, peu importe son nom exact.
  const arr = Object.values(mod).find((v) => Array.isArray(v));
  return (arr as import("../../components/Quiz").QuizQuestion[] | undefined) ?? null;
}

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.type === "article");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { year: "numeric", month: "long", day: "numeric" });
const quizQuestions = getQuizQuestions(article.data.quiz);
---

<Layout title={`${article.data.title} - Rudy Gault`} description={article.data.summary}>
  <a href="/blog/" class="mb-8 inline-block text-sm text-[var(--accent)] hover:underline">← Tous les articles</a>

  <p class="mb-3 text-xs text-[var(--fg-muted)]">{dateFormatter.format(article.data.date)}</p>
  <h1 class="mb-4 text-3xl font-bold text-[var(--fg)]">{article.data.title}</h1>

  <div class="mb-8 flex flex-wrap gap-2">
    {article.data.tags.map((tag) => (
      <span class="rounded-full bg-[var(--bg-elevated)] px-3 py-1 text-xs text-[var(--fg-muted)] ring-1 ring-[var(--border)]">
        {tag}
      </span>
    ))}
  </div>

  <article class="prose-content">
    <Content />
  </article>

  {quizQuestions && (
    <section class="mt-12 border-t border-[var(--border)] pt-8">
      <h2 class="mb-2 text-xl font-bold text-[var(--fg)]">Teste-toi</h2>
      <p class="mb-4 text-sm text-[var(--fg-muted)]">
        {quizQuestions.length} questions au total, {Math.min(10, quizQuestions.length)} tirées au
        hasard à chaque partie - relance pour un nouveau tirage.
      </p>
      <Quiz client:visible questions={quizQuestions} count={10} />
    </section>
  )}
</Layout>
