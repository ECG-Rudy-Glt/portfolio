---
import Layout from "../layouts/Layout.astro";
import { loadPortfolio, PALETTES, ZONE } from "../lib/pf";
const { projects, articles, demos, path, skills, HOMELAB } = await loadPortfolio();
const ZC = { entreprise: "#3fa7d6", perso: "#f2792a", ecole: "#9a8cf2" } as const;
const keys = ["entreprise", "perso", "ecole"] as const;
const zones = keys.map((k) => ({ k, label: ZONE[k], color: ZC[k], items: projects.filter((p) => p.cat === k) }));
// graphe : centre + trois grappes
const cx = 400, cy = 230, centers = [[130, 120], [640, 120], [400, 400]] as const;
const nodes = zones.flatMap((z, zi) => z.items.map((p, i) => {
  const a = (i / z.items.length) * Math.PI * 2 + zi, r = 34 + (i % 3) * 22;
  return { name: p.title, href: p.fiche, color: z.color, x: Math.round(centers[zi][0] + Math.cos(a) * r), y: Math.round(centers[zi][1] + Math.sin(a) * r), zi };
}));
const quick = [
  { k: "RÉALISATIONS", t: "Projets", x: `${projects.length} projets : entreprise, personnels et école.`, h: "#zones" },
  { k: "SANS COMPTE", t: "Démos", x: `${demos.length} démos en ligne et des sites à visiter.`, h: "#demos" },
  { k: "BLOG", t: "Articles", x: `${articles.length} articles : homelab, DevOps, certifications.`, h: "#articles" },
  { k: "INFRASTRUCTURE", t: "Homelab", x: "Visite guidée de mon infrastructure.", h: HOMELAB },
];
---
<Layout bare title="Rudy Gault - Topologie" description="Les projets de Rudy Gault organisés en zones : entreprise, personnel, école.">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </Fragment>
  <div class="sk topo" data-palette="Nuit">
    <div class="wrap">
      <header class="bar mono">
        <a href="/topologie/">RG // TOPOLOGIE</a>
        <nav aria-label="Navigation principale"><a href="#zones">Zones</a><a href="#demos">Démos</a><a href="#articles">Articles</a><a href="#parcours">Parcours</a><a href="/competences/">Compétences</a></nav>
        <details class="pal"><summary>palette : <span id="sk-pal-name">Nuit</span> ▾</summary><div>{PALETTES.map((n) => <button type="button" data-pal={n}>{n}</button>)}<a href="/modes/">autres styles…</a><a href="/?mode=classique">site classique</a></div></details>
      </header>

      <section class="hero">
        <div>
          <p class="mono mu">ALTERNANT INFRASTRUCTURE &amp; DEVOPS</p>
          <h1 class="cond">Rudy Gault</h1>
          <p class="lede">Cloud Temple (3 ans d'alternance), SUPINFO 4<sup>e</sup> année, fin de cursus en septembre 2027. Mes projets sont rangés en zones, comme un réseau : survolez un point pour le reconnaître.</p>
          <p class="mono hv" id="hv" aria-live="polite">Survolez un nœud</p>
          <ul class="legend mono">{zones.map((z, i) => <li><i style={`background:${z.color}`}></i>ZONE {i + 1} · {z.label.toUpperCase()}</li>)}</ul>
        </div>
        <svg viewBox="0 0 800 500" role="img" aria-label="Carte des projets en trois zones reliées à un nœud central" class="graph">
          {zones.map((z, zi) => <circle cx={centers[zi][0]} cy={centers[zi][1]} r="92" fill={z.color} fill-opacity=".08" stroke={z.color} stroke-opacity=".5" stroke-dasharray="5 6" />)}
          {nodes.map((n) => <line x1={cx} y1={cy} x2={n.x} y2={n.y} stroke={n.color} stroke-opacity=".28" />)}
          {zones.map((z, zi) => <line x1={cx} y1={cy} x2={centers[zi][0]} y2={centers[zi][1]} stroke={z.color} stroke-width="2" stroke-opacity=".6" />)}
          <circle cx={cx} cy={cy} r="30" fill="var(--bg)" stroke="var(--fg)" stroke-width="3" /><text x={cx} y={cy + 6} text-anchor="middle" class="mono" font-size="18" font-weight="600" fill="var(--fg)">RG</text>
          {nodes.map((n) => <a href={n.href}><circle class="nd" data-name={n.name} cx={n.x} cy={n.y} r="9" fill={n.color} stroke="var(--bg)" stroke-width="2"><title>{n.name}</title></circle></a>)}
        </svg>
      </section>

      <section class="quick">
        {quick.map((q) => <a class="tile" href={q.h}><span class="mono mu">{q.k}</span><b class="cond">{q.t}</b><span class="mu">{q.x}</span></a>)}
      </section>

      <section id="zones" class="sec">
        {zones.map((z, i) => (
          <div class="zn" style={`--z:${z.color}`}>
            <h2 class="cond"><i></i>Zone {i + 1} · {z.label} <span class="mono mu">{z.items.length} projets</span></h2>
            <div class="tiles">
              {z.items.map((p) => (
                <article class="tile">
                  <a class="cond ttl" href={p.fiche}>{p.title}</a>
                  <span class="mu">{p.summary}</span>
                  <span class="lk mono">{p.site && <a href={p.site} rel="noreferrer">site</a>}{p.demo && <a href={p.demo} rel="noreferrer">démo</a>}{p.repo && <a href={p.repo} rel="noreferrer">code</a>}</span>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section id="demos" class="sec">
        <h2 class="cond">Démos en ligne, sans compte</h2>
        {demos.map((p) => <a class="band" href={p.demo} rel="noreferrer"><b class="cond">{p.title}</b><span class="mu">données fictives</span><span class="mono">ouvrir →</span></a>)}
      </section>
      <section id="articles" class="sec">
        <h2 class="cond">Articles</h2>
        {articles.map((a) => <a class="band" href={a.href} rel={a.external ? "noreferrer" : undefined}><span class="mono mu">{a.date}</span><span>{a.title}</span><span class="mono mu">{a.tag}</span></a>)}
      </section>
      <section id="parcours" class="sec">
        <h2 class="cond">Parcours</h2>
        {path.map((s) => <div class="band st"><span class="mono mu">{s.when}</span><span>{s.what}</span></div>)}
        <p class="mono skl">{skills.join(" · ")}</p>
        <p><a class="pl mono" href="/parcours/">Parcours détaillé →</a> · <a class="pl mono" href="/cv-rudy-gault.pdf">CV →</a></p>
      </section>
      <footer class="mono mu">© Rudy Gault · <a href="https://github.com/ECG-Rudy-Glt">github</a> · <a href="https://www.linkedin.com/in/rudy-gault/">linkedin</a> · <a href="/modes/">changer de style</a></footer>
    </div>
  </div>
  <script>
    import "../scripts/skin-palette.ts";
    const hv = document.getElementById("hv")!;
    document.querySelectorAll<SVGElement>(".nd").forEach((n) => {
      const on = () => { hv.textContent = n.getAttribute("data-name") || ""; n.setAttribute("r", "13"); };
      const off = () => { hv.textContent = "Survolez un nœud"; n.setAttribute("r", "9"); };
      n.addEventListener("mouseenter", on); n.addEventListener("mouseleave", off);
      n.parentElement!.addEventListener("focus", on); n.parentElement!.addEventListener("blur", off);
    });
  </script>
</Layout>
<style is:global>
  .topo { font-family:'Barlow', system-ui, sans-serif; font-size:16px; line-height:1.5; }
  .topo .wrap { max-width:1180px; margin:0 auto; padding:0 20px 40px; }
  .topo .bar { display:flex; flex-wrap:wrap; gap:6px 22px; align-items:center; padding:14px 0; border-bottom:1px solid var(--bd); font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; position:relative; }
  .topo .bar nav { display:flex; flex-wrap:wrap; gap:4px 18px; flex:1; } .topo .bar nav a:hover { color:var(--ink); }
  .topo .hero { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1.15fr); gap:24px; align-items:center; padding:30px 0 18px; }
  .topo h1 { font-size:clamp(64px, 10vw, 120px); line-height:.9; margin:6px 0 12px; font-weight:800; }
  .topo .lede { max-width:46ch; font-size:18px; }
  .topo .hv { min-height:1.6em; color:var(--ink); font-size:14px; }
  .topo .legend { list-style:none; padding:0; margin:10px 0 0; font-size:11.5px; display:flex; flex-direction:column; gap:3px; color:var(--mu); }
  .topo .legend i { display:inline-block; width:10px; height:10px; margin-right:8px; }
  .topo .graph { width:100%; height:auto; }
  .topo .nd { cursor:pointer; transition:r .12s ease; } .topo .graph a:focus-visible .nd { stroke:var(--fg); }
  .topo .quick { display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; margin:10px 0 0; }
  .topo .tile { display:flex; flex-direction:column; gap:4px; border:1px solid var(--bd); background:var(--el); padding:14px; }
  .topo .tile:hover { background:var(--fg); color:var(--bg); } .topo .tile:hover .mu { color:inherit; opacity:.8; }
  .topo .tile b { font-size:26px; font-weight:700; line-height:1; }
  .topo .sec { padding-top:34px; }
  .topo h2 { font-size:30px; margin:0 0 12px; font-weight:700; }
  .topo .zn h2 { display:flex; align-items:center; gap:10px; flex-wrap:wrap; } .topo .zn h2 i { width:16px; height:16px; background:var(--z); }
  .topo .zn { margin-bottom:26px; } .topo h2 span { font-size:13px; font-weight:400; text-transform:uppercase; }
  .topo .tiles { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:10px; }
  .topo .zn .tile { border-top:4px solid var(--z); }
  .topo .ttl { font-size:22px; font-weight:700; line-height:1.05; }
  .topo .lk { display:flex; gap:12px; margin-top:auto; padding-top:6px; font-size:12px; }
  .topo .lk a { text-decoration:underline; text-underline-offset:3px; padding:6px 0; min-height:32px; }
  .topo .band { display:grid; grid-template-columns:120px 1fr 130px; gap:12px; padding:11px 10px; border-bottom:1px solid var(--bd); transition:transform .18s ease; }
  .topo a.band:hover { transform:translateX(6px); color:var(--ink); }
  .topo .band b { font-size:22px; font-weight:700; grid-column:1; } .topo .band.st { grid-template-columns:110px 1fr; }
  .topo .skl { font-size:13px; margin:16px 0 10px; }
  .topo .pl:hover { color:var(--ink); }
  .topo footer { margin-top:40px; border-top:1px solid var(--bd); padding-top:14px; font-size:12px; }
  @media (max-width:860px) { .topo .hero { grid-template-columns:1fr; } .topo .quick { grid-template-columns:1fr 1fr; } }
  @media (max-width:640px) { .topo .band { grid-template-columns:1fr; gap:2px; } .topo .band.st { grid-template-columns:90px 1fr; } .topo .quick { grid-template-columns:1fr; } }
  @media (prefers-reduced-motion:reduce) { .topo .band, .topo .nd { transition:none; } .topo a.band:hover { transform:none; } }
</style>
