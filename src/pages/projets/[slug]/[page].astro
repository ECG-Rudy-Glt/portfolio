---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import ProjectPageNav from "../../../components/ProjectPageNav.astro";

export async function getStaticPaths() {
  const pages = await getCollection("projectPages");
  return pages.map((entry) => {
    const [project, page] = entry.id.split("/");
    return {
      params: { slug: project, page },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const project = await getEntry("projects", entry.data.project);

const siblings = (await getCollection("projectPages"))
  .filter((p) => p.data.project === entry.data.project)
  .sort((a, b) => a.data.order - b.data.order);

const currentIndex = siblings.findIndex((s) => s.id === entry.id);
const prev = currentIndex > 0 ? siblings[currentIndex - 1] : null;
const next = currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : null;
const navItems = siblings.map((s) => ({ href: `/projets/${entry.data.project}/${s.id.split("/")[1]}/`, title: s.data.title, group: s.data.group, current: s.id === entry.id }));
---

<Layout alt={`/en/projets/${entry.data.project}/${entry.id.split("/")[1]}/`} title={`${entry.data.title} - Rudy Gault`} description={entry.data.summary}>
  <a href={`/projets/${entry.data.project}/`} class="mb-8 inline-block text-sm text-[var(--accent)] hover:underline">
    ← {project?.data.title ?? "Retour au projet"}
  </a>

  <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
  <ProjectPageNav items={navItems} projectTitle={project?.data.title ?? "Projet"} projectHref={`/projets/${entry.data.project}/`} label="Sommaire" progress={`Page ${currentIndex + 1} sur ${siblings.length}`} />
  <div class="min-w-0">

  <h1 class="mb-4 text-3xl font-bold text-[var(--fg)]">{entry.data.title}</h1>
  <p class="mb-8 text-lg text-[var(--fg-muted)]">{entry.data.summary}</p>

  <details class="mb-10 rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] lg:hidden">
    <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-[var(--fg)]">Sommaire · page {currentIndex + 1} sur {siblings.length}</summary>
    <ul class="space-y-0.5 border-t border-[var(--border)] px-2 py-2">
      {navItems.map((it) => (
        <li>
          <a href={it.href} aria-current={it.current ? "page" : undefined}
            class:list={["block rounded-md px-2 py-1.5 text-sm", it.current ? "bg-[var(--accent)] text-white" : "text-[var(--fg-muted)] hover:text-[var(--fg)]"]}>
            {it.title}
          </a>
        </li>
      ))}
    </ul>
  </details>

  <article class="prose-content">
    <Content />
  </article>

  <div class="mt-10 flex items-center justify-between gap-4 border-t border-[var(--border)] pt-8">
    {prev ? (
      <a
        href={`/projets/${entry.data.project}/${prev.id.split("/")[1]}/`}
        class="flex-1 rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4 text-left transition-colors hover:border-[var(--accent)]"
      >
        <span class="block text-xs text-[var(--fg-muted)]">← Précédent</span>
        <span class="mt-1 block text-sm font-medium text-[var(--fg)]">{prev.data.title}</span>
      </a>
    ) : <div class="flex-1" />}
    {next ? (
      <a
        href={`/projets/${entry.data.project}/${next.id.split("/")[1]}/`}
        class="flex-1 rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4 text-right transition-colors hover:border-[var(--accent)]"
      >
        <span class="block text-xs text-[var(--fg-muted)]">Suivant →</span>
        <span class="mt-1 block text-sm font-medium text-[var(--fg)]">{next.data.title}</span>
      </a>
    ) : <div class="flex-1" />}
  </div>
  </div>
  </div>
</Layout>
