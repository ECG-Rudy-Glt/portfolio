---
import { getCollection } from "astro:content";

const weight = { majeur: 0, pertinent: 1, secondaire: 2 } as const;
const items = (await getCollection("projects"))
  .filter((p) => p.data.links.demo || p.data.links.sandbox)
  .sort((a, b) => weight[a.data.relevance] - weight[b.data.relevance] || a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    name: p.data.title.split(" - ")[0],
    text: (p.data.title.split(" - ")[1] ?? p.data.summary).replace(/^./, (c) => c.toUpperCase()),
    site: p.data.links.demo,
    live: p.data.links.sandbox,
    host: new URL((p.data.links.sandbox ?? p.data.links.demo)!).hostname.replace(/^www\./, ""),
  }));
const { title = "Sites et démos en ligne", note = "Cliquez pour les essayer, sans compte" } = Astro.props;
---

<section class="live" aria-label={title}>
  <div class="live-head">
    <h2>{title}</h2>
    <p>{note}</p>
  </div>
  <div class="live-viewport">
    <ul class="live-track">
      {[0, 1].map((copy) =>
        items.map((it) => (
          <li class="live-card" aria-hidden={copy === 1 ? "true" : undefined}>
            <a class="live-name" href={it.live ?? it.site} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>{it.name}<span aria-hidden="true"> ↗</span></a>
            <span class="live-text">{it.text}</span>
            <span class="live-host">{it.host}</span>
            <span class="live-links">
              {it.live && <a href={it.live} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>Démo en ligne</a>}
              {it.site && <a href={it.site} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>{it.live ? "Présentation" : "Site"}</a>}
              <a href={`/projets/${it.id}/`} tabindex={copy === 1 ? -1 : undefined}>Fiche</a>
            </span>
          </li>
        ))
      )}
    </ul>
  </div>
</section>

<style>
  .live { margin: 0 0 3.5rem; }
  .live-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem; margin-bottom: 0.9rem; }
  .live-head h2 { font-size: 1.25rem; font-weight: 600; color: var(--fg); margin: 0; }
  .live-head p { font-size: 0.875rem; color: var(--fg-muted); margin: 0; }
  .live-viewport { overflow: hidden; mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent); }
  .live-track { display: flex; gap: 1rem; width: max-content; margin: 0; padding: 0.25rem 0; list-style: none; animation: live-scroll 55s linear infinite; }
  .live-viewport:hover .live-track, .live-viewport:focus-within .live-track { animation-play-state: paused; }
  @keyframes live-scroll { to { transform: translateX(calc(-50% - 0.5rem)); } }
  .live-card { display: flex; flex-direction: column; gap: 0.35rem; width: 18.5rem; flex: none; padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: 0.9rem; background: var(--bg-elevated); }
  .live-name { font-weight: 600; color: var(--fg); text-decoration: none; }
  .live-name:hover { color: var(--accent); }
  .live-text { font-size: 0.85rem; color: var(--fg-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }
  .live-host { font-size: 0.75rem; color: var(--fg-muted); opacity: 0.85; }
  .live-links { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.3rem; }
  .live-links a { font-size: 0.8rem; padding: 0.4rem 0.7rem; min-height: 36px; display: inline-flex; align-items: center; border-radius: 999px; border: 1px solid var(--border); color: var(--fg); text-decoration: none; }
  .live-links a:first-child { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
  .live-links a:hover { border-color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .live-viewport { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
    .live-track { animation: none; }
    .live-card[aria-hidden="true"] { display: none; }
  }
  :global(:root.no-anim) .live-viewport { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
  :global(:root.no-anim) .live-track { animation: none; }
  :global(:root.no-anim) .live-card[aria-hidden="true"] { display: none; }
</style>
