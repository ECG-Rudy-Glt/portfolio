---
import { getCollection } from "astro:content";
import { existsSync } from "node:fs";
import { enProject } from "../i18n/projects-en";
import type { Lang } from "../i18n/ui";

const { title: titleProp, note: noteProp, eyebrow, lang = "fr" } = Astro.props as { title?: string; note?: string; eyebrow?: string; lang?: Lang };
const en = lang === "en";

// supchat.fr n'existe plus (NXDOMAIN) : pas de carte vers un site mort.
const EXCLUDE = new Set(["supchat"]);
const weight = { majeur: 0, pertinent: 1, secondaire: 2 } as const;
const items = (await getCollection("projects"))
  .filter((p) => (p.data.links.demo || p.data.links.sandbox) && !EXCLUDE.has(p.id))
  .sort((a, b) => weight[a.data.relevance] - weight[b.data.relevance] || a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    name: (en ? enProject(p.id, p.data).title : p.data.title).split(" - ")[0],
    img: existsSync(`./public/sites/${p.id}.webp`) ? `/sites/${p.id}.webp?v=3` : undefined,
    text: ((en ? enProject(p.id, p.data).title : p.data.title).split(" - ")[1] ?? (en ? enProject(p.id, p.data).summary : p.data.summary)).replace(/^./, (c) => c.toUpperCase()),
    site: p.data.links.demo,
    live: p.data.links.sandbox,
    host: new URL((p.data.links.sandbox ?? p.data.links.demo)!).hostname.replace(/^www\./, ""),
  }));
const title = titleProp ?? (en ? "Live sites and demos" : "Sites et démos en ligne");
const note = noteProp ?? (en ? "Click to try them, no account needed" : "Cliquez pour les essayer, sans compte");
const label = title.replace(/<[^>]+>/g, "");
---

<section class="live" aria-label={label}>
  <div class="live-head">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 set:html={title} />
      <p>{note}</p>
    </div>
    <div class="live-nav">
      <button type="button" class="live-btn" data-dir="-1" aria-label={en ? "Previous" : "Précédent"}>←</button>
      <button type="button" class="live-btn" data-dir="1" aria-label={en ? "Next" : "Suivant"}>→</button>
    </div>
  </div>
  <div class="live-viewport" tabindex="0" role="group" aria-label={en ? `${label}: scroll horizontally` : `${label} : faites défiler horizontalement`}>
    <ul class="live-track">
      {[0, 1].map((copy) =>
        items.map((it) => (
          <li class="live-card" aria-hidden={copy === 1 ? "true" : undefined}>
            {it.img && (
              <a class="live-shot" href={it.live ?? it.site} rel="noreferrer" tabindex="-1" aria-hidden="true"><img src={it.img} alt="" width="640" height="400" loading="lazy" decoding="async" /></a>
            )}
            <a class="live-name" href={it.live ?? it.site} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>{it.name}<span aria-hidden="true"> ↗</span></a>
            <span class="live-text">{it.text}</span>
            <span class="live-host">{it.host}</span>
            <span class="live-links">
              {it.live && <a href={it.live} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>{en ? "Live demo" : "Démo en ligne"}</a>}
              {it.site && <a href={it.site} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>{it.live ? (en ? "Overview" : "Présentation") : (en ? "Website" : "Site")}</a>}
              <a href={`/projets/${it.id}/`} tabindex={copy === 1 ? -1 : undefined}>{en ? "Case study (FR)" : "Fiche"}</a>
            </span>
          </li>
        ))
      )}
    </ul>
  </div>
</section>

<style>
  .live { margin: 0; }
  .live-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem 1.5rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .live-nav { display: flex; gap: 0.5rem; flex: none; }
  .live-btn { width: 48px; height: 48px; border-radius: 999px; border: 1px solid var(--fg); background: transparent; color: var(--fg); cursor: pointer; font-size: 1.05rem; transition: background-color .16s ease, color .16s ease; }
  .live-btn[data-dir="1"] { background: var(--fg); color: var(--bg); }
  .live-btn:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
  .live-head h2 { font-size: clamp(2.1rem, 4vw, 3rem); line-height: 1.1; color: var(--fg); margin: 0.4rem 0 0; }
  .live-head p:not(.eyebrow) { font-size: 0.9rem; color: var(--fg-muted); margin: 0.5rem 0 0; }
  .live-viewport { overflow-x: auto; overflow-y: hidden; scrollbar-width: none; -ms-overflow-style: none; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
  .live-viewport::-webkit-scrollbar { display: none; }
  .live-track { display: flex; gap: 1.5rem; width: max-content; margin: 0; padding: 0.25rem 0; list-style: none; }
  .live-card { display: flex; flex-direction: column; gap: 0.5rem; width: min(26rem, 80vw); flex: none; }
  .live-shot { display: block; margin-bottom: 0.35rem; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); aspect-ratio: 16 / 10; background: var(--bg-deep); }
  .live-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform 0.5s ease; }
  .live-card:hover .live-shot img { transform: scale(1.03); }
  .live-name { font-weight: 600; font-size: 1.05rem; color: var(--fg); text-decoration: none; }
  .live-name:hover { color: var(--accent); }
  .live-text { font-size: 0.9rem; color: var(--fg-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
  .live-host { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); }
  .live-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-top: 0.2rem; }
  .live-links a { font-size: 0.85rem; min-height: 32px; display: inline-flex; align-items: center; color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--border); }
  .live-links a:first-child { border-bottom-color: var(--accent); color: var(--accent); }
  .live-links a:hover { border-bottom-color: var(--fg); }
  @media (prefers-reduced-motion: reduce) {
    .live-card[aria-hidden="true"] { display: none; }
  }
  :global(:root.no-anim) .live-card[aria-hidden="true"] { display: none; }
  :global(:root.no-anim) .live-shot img { transition: none; }
</style>

<script>
  // Défilement automatique doux, qui s'arrête dès que le visiteur touche, survole, navigue au clavier ou clique une flèche.
  document.querySelectorAll<HTMLElement>(".live").forEach((root) => {
    const vp = root.querySelector<HTMLElement>(".live-viewport")!;
    const track = root.querySelector<HTMLElement>(".live-track")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("no-anim");
    const step = () => (track.firstElementChild as HTMLElement).offsetWidth + 24;
    root.querySelectorAll<HTMLButtonElement>(".live-btn").forEach((b) =>
      b.addEventListener("click", () => { hold(); vp.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: still ? "auto" : "smooth" }); }),
    );
    let pos = 0, paused = false, until = 0, last = performance.now(), auto = false;
    function hold(ms = 5000) { until = performance.now() + ms; }
    ["wheel", "touchstart", "pointerdown", "keydown", "focusin"].forEach((e) => vp.addEventListener(e, () => hold(), { passive: true }));
    vp.addEventListener("mouseenter", () => (paused = true));
    vp.addEventListener("mouseleave", () => { paused = false; hold(1200); });
    vp.addEventListener("scroll", () => { if (!auto) pos = vp.scrollLeft; }, { passive: true });
    if (still) return;
    function frame(now: number) {
      const dt = Math.min(now - last, 64); last = now;
      if (!paused && now > until && !document.hidden) {
        const half = track.scrollWidth / 2;
        pos += dt * 0.035;
        if (pos >= half) pos -= half;
        auto = true; vp.scrollLeft = pos; auto = false;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  });
</script>
