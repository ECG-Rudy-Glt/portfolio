---
import { getCollection } from "astro:content";
import { existsSync } from "node:fs";

// supchat.fr n'existe plus (NXDOMAIN) : pas de carte vers un site mort.
const EXCLUDE = new Set(["supchat"]);
const weight = { majeur: 0, pertinent: 1, secondaire: 2 } as const;
const items = (await getCollection("projects"))
  .filter((p) => (p.data.links.demo || p.data.links.sandbox) && !EXCLUDE.has(p.id))
  .sort((a, b) => weight[a.data.relevance] - weight[b.data.relevance] || a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    name: p.data.title.split(" - ")[0],
    img: existsSync(`./public/sites/${p.id}.webp`) ? `/sites/${p.id}.webp` : undefined,
    text: (p.data.title.split(" - ")[1] ?? p.data.summary).replace(/^./, (c) => c.toUpperCase()),
    site: p.data.links.demo,
    live: p.data.links.sandbox,
    host: new URL((p.data.links.sandbox ?? p.data.links.demo)!).hostname.replace(/^www\./, ""),
  }));
const { title = "Sites et démos en ligne", note = "Cliquez pour les essayer, sans compte" } = Astro.props;
---

<section class="live" aria-label={title}>
  <div class="live-head">
    <div>
      <h2>{title}</h2>
      <p>{note}</p>
    </div>
    <div class="live-nav">
      <button type="button" class="live-btn" data-dir="-1" aria-label="Précédent">←</button>
      <button type="button" class="live-btn" data-dir="1" aria-label="Suivant">→</button>
    </div>
  </div>
  <div class="live-viewport" tabindex="0" role="group" aria-label={`${title} : faites défiler horizontalement`}>
    <ul class="live-track">
      {[0, 1].map((copy) =>
        items.map((it) => (
          <li class="live-card" aria-hidden={copy === 1 ? "true" : undefined}>
            {it.img && (
              <a class="live-shot" href={it.live ?? it.site} rel="noreferrer" tabindex="-1" aria-hidden="true"><img src={it.img} alt="" width="640" height="400" loading="lazy" decoding="async" /></a>
            )}
            <a class="live-name" href={it.live ?? it.site} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>{it.name}<span aria-hidden="true"> ↗</span></a>
            <span class="live-text">{it.text}</span>
            <span class="live-host">{it.host}</span>
            <span class="live-links">
              {it.live && <a href={it.live} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>Démo en ligne</a>}
              {it.site && <a href={it.site} rel="noreferrer" tabindex={copy === 1 ? -1 : undefined}>{it.live ? "Présentation" : "Site"}</a>}
              <a href={`/projets/${it.id}/`} tabindex={copy === 1 ? -1 : undefined}>Fiche</a>
            </span>
          </li>
        ))
      )}
    </ul>
  </div>
</section>

<style>
  .live { margin: 0 0 3.5rem; }
  .live-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.5rem 1rem; margin-bottom: 0.9rem; }
  .live-nav { display: flex; gap: 0.4rem; flex: none; }
  .live-btn { width: 40px; height: 40px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-elevated); color: var(--fg); cursor: pointer; font-size: 1rem; }
  .live-btn:hover { border-color: var(--accent); color: var(--accent); }
  .live-head h2 { font-size: 1.25rem; font-weight: 600; color: var(--fg); margin: 0; }
  .live-head p { font-size: 0.875rem; color: var(--fg-muted); margin: 0; }
  .live-viewport { overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; scrollbar-color: var(--border) transparent; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent); }
  .live-track { display: flex; gap: 1rem; width: max-content; margin: 0; padding: 0.25rem 0; list-style: none; }
  .live-card { display: flex; flex-direction: column; gap: 0.35rem; width: 18.5rem; flex: none; padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: 0.9rem; background: var(--bg-elevated); }
  .live-shot { display: block; margin: -1rem -1.1rem 0.4rem; border-radius: 0.9rem 0.9rem 0 0; overflow: hidden; border-bottom: 1px solid var(--border); aspect-ratio: 16 / 10; background: var(--bg); }
  .live-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform 0.4s ease; }
  .live-card:hover .live-shot img { transform: scale(1.04); }
  .live-name { font-weight: 600; color: var(--fg); text-decoration: none; }
  .live-name:hover { color: var(--accent); }
  .live-text { font-size: 0.85rem; color: var(--fg-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }
  .live-host { font-size: 0.75rem; color: var(--fg-muted); opacity: 0.85; }
  .live-links { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.3rem; }
  .live-links a { font-size: 0.8rem; padding: 0.4rem 0.7rem; min-height: 36px; display: inline-flex; align-items: center; border-radius: 999px; border: 1px solid var(--border); color: var(--fg); text-decoration: none; }
  .live-links a:first-child { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
  .live-links a:hover { border-color: var(--accent); }
  :global(:root.no-anim) .live-shot img { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .live-viewport { mask-image: none; -webkit-mask-image: none; }
    .live-card[aria-hidden="true"] { display: none; }
  }
  :global(:root.no-anim) .live-viewport { mask-image: none; -webkit-mask-image: none; }
  :global(:root.no-anim) .live-card[aria-hidden="true"] { display: none; }
  :global(:root.no-anim) .live-shot img { transition: none; }
</style>

<script>
  // Défilement automatique doux, qui s'arrête dès que le visiteur touche, survole, navigue au clavier ou clique une flèche.
  document.querySelectorAll<HTMLElement>(".live").forEach((root) => {
    const vp = root.querySelector<HTMLElement>(".live-viewport")!;
    const track = root.querySelector<HTMLElement>(".live-track")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("no-anim");
    const step = () => (track.firstElementChild as HTMLElement).offsetWidth + 16;
    root.querySelectorAll<HTMLButtonElement>(".live-btn").forEach((b) =>
      b.addEventListener("click", () => { hold(); vp.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: still ? "auto" : "smooth" }); }),
    );
    let pos = 0, paused = false, until = 0, last = performance.now(), auto = false;
    function hold(ms = 5000) { until = performance.now() + ms; }
    ["wheel", "touchstart", "pointerdown", "keydown", "focusin"].forEach((e) => vp.addEventListener(e, () => hold(), { passive: true }));
    vp.addEventListener("mouseenter", () => (paused = true));
    vp.addEventListener("mouseleave", () => { paused = false; hold(1200); });
    vp.addEventListener("scroll", () => { if (!auto) pos = vp.scrollLeft; }, { passive: true });
    if (still) return;
    function frame(now: number) {
      const dt = Math.min(now - last, 64); last = now;
      if (!paused && now > until && !document.hidden) {
        const half = track.scrollWidth / 2;
        pos += dt * 0.035;
        if (pos >= half) pos -= half;
        auto = true; vp.scrollLeft = pos; auto = false;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  });
</script>
