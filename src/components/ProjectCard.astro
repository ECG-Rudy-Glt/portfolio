---
import { existsSync } from "node:fs";
interface Props {
  slug: string;
  title: string;
  summary: string;
  period: string;
  tags: string[];
  category: "perso" | "ecole" | "entreprise";
  relevance: "majeur" | "pertinent" | "secondaire";
}

const { slug, title, summary, period, tags, category, relevance } = Astro.props;

const thumb = existsSync(`./public/sites/${slug}.webp`) ? `/sites/${slug}.webp` : undefined;

const categoryLabel: Record<Props["category"], string> = {
  perso: "Projet perso",
  ecole: "Projet école",
  entreprise: "Entreprise",
};

const relevanceLabel: Record<Props["relevance"], string> = {
  majeur: "Projet majeur",
  pertinent: "Pertinent",
  secondaire: "Secondaire",
};
---

<a
  href={`/projets/${slug}/`}
  class="group flex flex-col gap-3 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-6 transition-colors hover:border-[var(--accent)]"
  data-category={category}
  data-tags={tags.join(",")}
>
  {thumb && (
    <div class="-mx-6 -mt-6 mb-1 aspect-[16/10] overflow-hidden border-b border-[var(--border)] bg-[var(--bg)]">
      <img src={thumb} alt="" width="640" height="400" loading="lazy" decoding="async" class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]" />
    </div>
  )}
  <div class="flex items-center justify-between text-xs text-[var(--fg-muted)]">
    <span class="font-mono uppercase tracking-[0.04em]">{categoryLabel[category]}</span>
    <span class="font-mono">{period}</span>
  </div>
  <h3 class="font-display text-2xl leading-tight text-[var(--fg)] group-hover:text-[var(--accent)]">{title}</h3>
  <p class="text-sm text-[var(--fg-muted)]">{summary}</p>
  <div class="flex items-center gap-1.5 text-xs" style={`color: var(--relevance-${relevance})`}>
    <span class="h-2 w-2 rounded-full" style={`background-color: var(--relevance-${relevance})`}></span>
    {relevanceLabel[relevance]}
  </div>
  <div class="mt-auto flex flex-wrap gap-2 pt-2">
    {tags.slice(0, 4).map((tag) => (
      <span class="rounded-full bg-[var(--bg)] px-2 py-1 text-xs text-[var(--fg-muted)] ring-1 ring-[var(--border)]">
        {tag}
      </span>
    ))}
  </div>
</a>
