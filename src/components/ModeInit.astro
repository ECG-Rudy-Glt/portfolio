---
// Applique le mode, la palette et le réglage d'animation mémorisés avant le premier rendu.
---
<script is:inline>
  try {
    var r = document.documentElement, ls = localStorage;
    if (ls.getItem("mode") === "minimal") r.classList.add("hn");
    var p = ls.getItem("palette");
    if (p === "foret" || p === "ardoise") r.classList.add("pal-" + p);
    var a = ls.getItem("anim");
    if (a === "off" || (a !== "on" && matchMedia("(prefers-reduced-motion: reduce)").matches)) r.classList.add("no-anim");
  } catch (e) {}
</script>
