---
import { PERIODS, TOOLS, GROUPS, NOW } from "../data/skillTimeline";
import { enProject } from "../i18n/projects-en";
interface Props { projects: { id: string; data: { title: string; summary: string; period: string; category: "perso" | "ecole" | "entreprise"; tags: string[]; stack: string[] } }[]; lang?: "fr" | "en"; limit?: number }
const { projects, lang = "fr", limit } = Astro.props;
const en = lang === "en";
const START = 2022.5, END = 2027.5, SPAN = END - START;
const pct = (x: number) => ((x - START) / SPAN) * 100;
const CATS = [
  { key: "entreprise", label: en ? "Professional" : "Entreprise", v: "--c-ent" },
  { key: "perso", label: en ? "Personal" : "Perso", v: "--c-perso" },
  { key: "ecole", label: en ? "School" : "École", v: "--c-ecole" },
] as const;

const merge = (iv: [number, number][]) => {
  const s = [...iv].sort((a, b) => a[0] - b[0]); const out: [number, number][] = [];
  for (const i of s) { const l = out[out.length - 1]; if (l && i[0] <= l[1]) l[1] = Math.max(l[1], i[1]); else out.push([i[0], i[1]]); }
  return out;
};
const rows = (limit ? TOOLS.filter((t) => t.home) : TOOLS).map((t) => {
  const keys = new Set(t.keys.map((k) => k.toLowerCase()));
  const hits = projects.filter((p) => PERIODS[p.id] && [...p.data.stack, ...p.data.tags].some((x) => keys.has(x.toLowerCase())));
  const lanes = CATS.map((c) => ({ ...c, bars: merge(hits.filter((p) => p.data.category === c.key).map((p) => [...PERIODS[p.id]] as [number, number])), n: hits.filter((p) => p.data.category === c.key).length }));
  const since = t.since ?? Math.min(...hits.map((p) => PERIODS[p.id][0]));
  if (t.since) for (const l of lanes) l.bars = l.bars.map(([a, b]) => [Math.max(a, t.since!), b] as [number, number]).filter(([a, b]) => b > a);
  const links = hits.sort((a, b) => PERIODS[b.id][0] - PERIODS[a.id][0]).map((p) => ({ id: p.id, cat: p.data.category, title: (en ? enProject(p.id, p.data as any).title : p.data.title).split(" - ")[0] }));
  return { group: t.group, name: t.name, lanes, since, continuous: !!t.since, n: hits.length, links };
}).filter((r) => r.n > 0);
const gkeys = Object.keys(GROUPS);
const sections = (limit ? [{ g: "", rows: rows.sort((a, b) => a.since - b.since) }] : gkeys.map((g) => ({ g, rows: rows.filter((r) => r.group === g).sort((a, b) => a.since - b.since) })).filter((x) => x.rows.length));
const LEARNING_START = new Date("2026-10-20");
const months = Math.max(1, Math.round((Date.now() - LEARNING_START.getTime()) / (30.44 * 864e5)));
const sinceLabel = en ? `since ${months} month${months > 1 ? "s" : ""}` : `depuis ${months} mois`;
const flat: any[] = sections.flatMap((x) => (x.g ? [{ header: en ? GROUPS[x.g].en : GROUPS[x.g].fr, g: x.g, count: x.rows.length }, ...x.rows.map((r) => ({ ...r, g: x.g }))] : x.rows));
const learning = ["Platform engineering", "Harness engineering"];
const LEARNING_START_Y = 2026.8;
const base = en ? "/en" : "";
const catVar = Object.fromEntries(CATS.map((c) => [c.key, c.v]));
const years = [2023, 2024, 2025, 2026, 2027];
const since = (y: number) => `${en ? "since" : "depuis"} ${Math.floor(y)}`;
---
<div class="stl">
  <ul class="stl-leg" aria-label={en ? "Legend" : "Légende"}>
    {CATS.map((c) => <li><i style={`background: var(${c.v})`}></i>{c.label}</li>)}
    <li><i class="stl-cont-sw"></i>{en ? "Continuous use" : "Usage continu"}</li>
    <li><i class="stl-learn-sw"></i>{en ? "Learning" : "En cours d'apprentissage"}</li>
  </ul>
  <div class="stl-scroll">
    <div class="stl-grid">
      <div class="stl-axis">
        {years.map((y) => <span style={`left:${pct(y)}%`}>{y}</span>)}
      </div>
      {flat.map((r, ri) => r.header ? (<button type="button" class="stl-group" data-group={r.g} aria-expanded="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>{r.header}<small>{r.count} {en ? (r.count > 1 ? "tools" : "tool") : (r.count > 1 ? "outils" : "outil")}</small></button>) : (
        <>
          <button type="button" class="stl-name stl-btn" data-g={r.g} aria-expanded="false" aria-controls={`stl-p-${ri}`}><span>{r.name}<em aria-hidden="true">+</em></span><small>{since(r.since)} · {r.n} {en ? (r.n > 1 ? "projects" : "project") : (r.n > 1 ? "projets" : "projet")}</small></button>
          <div class="stl-track" data-g={r.g} role="img" aria-label={`${r.name} ${since(r.since)}`}>
            {years.map((y) => <i class="stl-grid-line" style={`left:${pct(y)}%`}></i>)}
            <i class="stl-now" style={`left:${pct(NOW)}%`}></i>
            {r.continuous && <b class="stl-bar stl-cont" style={`left:${pct(r.since)}%;width:${pct(NOW) - pct(r.since)}%;--d:0ms;top:52px`}></b>}
            {r.lanes.map((l, li) => l.bars.map((b, bi) => (
              <b class="stl-bar" style={`left:${pct(b[0])}%;width:${pct(b[1]) - pct(b[0])}%;--d:${bi * 120}ms;top:${7 + li * 15}px;background:var(${l.v})`}></b>
            )))}
          </div>
          <div class="stl-panel" data-g={r.g} id={`stl-p-${ri}`} hidden>
            <span class="stl-pt">{en ? "Where it is used" : "Où c'est utilisé"}</span>
            {r.links.map((l) => <a href={`${base}/projets/${l.id}/`}><i style={`background: var(${catVar[l.cat]})`}></i>{l.title}</a>)}
          </div>
        </>
      ))}
      {learning.map((l, li) => (
        <>
          <div class="stl-name"><span>{l}</span><small>{sinceLabel}</small></div>
          <div class="stl-track" role="img" aria-label={`${l} ${sinceLabel}`}>
            {years.map((y) => <i class="stl-grid-line" style={`left:${pct(y)}%`}></i>)}
            <i class="stl-now" style={`left:${pct(NOW)}%`}></i>
            <b class="stl-bar stl-learn" style={`left:${pct(LEARNING_START_Y)}%;width:${pct(NOW) - pct(LEARNING_START_Y)}%;--d:${li * 120}ms;top:24px`}></b>
          </div>
        </>
      ))}
    </div>
  </div>
  <p class="stl-note">{en ? "Dates are approximate (school year and work-study periods, homelab from its first log entry). A bar is drawn wherever a project uses the tool." : "Dates à l'année ou au semestre près (années scolaires, alternance, homelab depuis son premier journal). Une barre est tracée partout où un projet utilise l'outil."}</p>
</div>
<style>
  .stl-leg { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 14px; padding: 0; list-style: none; font-size: 12px; color: var(--fg-muted); }
  .stl-leg li { display: flex; align-items: center; gap: 6px; }
  .stl-leg i { display: inline-block; width: 22px; height: 11px; border-radius: 6px; }
  .stl-scroll { overflow-x: auto; }
  .stl-grid { display: grid; grid-template-columns: 170px minmax(440px, 1fr); min-width: 640px; }
  .stl-axis { grid-column: 2; position: relative; height: 22px; font-family: var(--font-mono); font-size: 11px; color: var(--fg-muted); }
  .stl-axis span { position: absolute; transform: translateX(-50%); }
  .stl-name { display: flex; flex-direction: column; justify-content: center; padding: 6px 12px 6px 0; border-top: 1px solid var(--border); }
  .stl-group { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; margin-top: 14px; padding: 10px 0; background: none; border: 0; border-top: 1px solid var(--border); cursor: pointer; text-align: left; font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .stl-group svg { transition: transform .2s; }
  .stl-group[aria-expanded="true"] svg { transform: rotate(90deg); }
  .stl-group small { margin-left: auto; letter-spacing: 0; text-transform: none; color: var(--fg-muted); }
  .stl-group:hover, .stl-group:focus-visible { color: var(--fg); }
  .stl-grid .stl-shut { display: none !important; }
  .stl-cont { height: 3px; border-radius: 2px; background: var(--fg-muted); opacity: .55; }
  .stl-cont-sw { height: 3px !important; background: var(--fg-muted); opacity: .55; }
  .stl-btn { background: none; border: 0; border-top: 1px solid var(--border); text-align: left; cursor: pointer; font: inherit; color: inherit; }
  .stl-btn:hover span, .stl-btn:focus-visible span { color: var(--accent); }
  .stl-btn em { font-style: normal; margin-left: 8px; color: var(--fg-muted); font-weight: 400; }
  .stl-panel { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; padding: 12px 0 14px; border-top: 1px solid var(--border); }
  .stl-panel[hidden] { display: none; }
  .stl-pt { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-muted); margin-right: 6px; }
  .stl-panel a { display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--border); color: var(--fg); font-size: 14px; transition: border-color .2s, color .2s; }
  .stl-panel a:hover { border-color: var(--accent); color: var(--accent); }
  .stl-panel a i { width: 9px; height: 9px; border-radius: 50%; }
  .stl-name span { font-weight: 600; color: var(--fg); font-size: 15px; }
  .stl-name small { font-family: var(--font-mono); font-size: 11px; color: var(--fg-muted); }
  .stl-track { position: relative; height: 60px; border-top: 1px solid var(--border); }
  .stl-grid-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--border); opacity: .6; }
  .stl-now { position: absolute; top: 0; bottom: 0; width: 0; border-left: 1px dashed var(--accent); }
  .stl-bar { position: absolute; height: 11px; border-radius: 6px; transform-origin: left center; }
  .stl-js .stl-bar { transform: scaleX(0); }
  .stl-js .stl-in .stl-bar { transform: scaleX(1); transition: transform .7s cubic-bezier(.22, 1, .36, 1) calc(var(--b, 0ms) + var(--d)); }
  .stl-js .stl-now { opacity: 0; }
  .stl-js .stl-in .stl-now { opacity: 1; transition: opacity .4s ease .5s; }
  :global(:root.no-anim) .stl-js .stl-bar { transform: none; transition: none; }
  :global(:root.no-anim) .stl-js .stl-now { opacity: 1; transition: none; }
  .stl { --c-ent: #a9c29b; --c-perso: #e3b25e; --c-ecole: #7fa9d9; }
  :global(:root.clair) .stl { --c-ent: #3d6b45; --c-perso: #b87a14; --c-ecole: #3a6ea5; }
  .stl-note { margin-top: 14px; font-size: 12px; color: var(--fg-muted); max-width: 70ch; }
  .stl-now-learning { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border); }
  .stl-nl-title { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-muted); margin-right: 6px; }
  .stl-chip { padding: 4px 12px; border-radius: 999px; border: 1px dashed var(--accent); color: var(--fg); font-size: 13px; }
  .stl-chip small { font-family: var(--font-mono); font-size: 11px; color: var(--fg-muted); margin-left: 4px; }
  .stl-learn { background: repeating-linear-gradient(135deg, var(--accent) 0 5px, transparent 5px 9px); border: 1px solid var(--accent); }
  .stl-learn-sw { background: repeating-linear-gradient(135deg, var(--accent) 0 5px, transparent 5px 9px); border: 1px solid var(--accent); }
</style>
<script>
  document.querySelectorAll<HTMLElement>(".stl").forEach((el) => {
    el.querySelectorAll<HTMLButtonElement>(".stl-btn").forEach((b) => {
      const panel = document.getElementById(b.getAttribute("aria-controls")!);
      const track = b.nextElementSibling as HTMLElement | null;
      const toggle = () => {
        const open = b.getAttribute("aria-expanded") === "true";
        b.setAttribute("aria-expanded", String(!open));
        if (panel) panel.hidden = open;
        const em = b.querySelector("em"); if (em) em.textContent = open ? "+" : "−";
      };
      b.addEventListener("click", toggle);
      if (track) { track.style.cursor = "pointer"; track.addEventListener("click", toggle); }
    });
  });
  document.querySelectorAll<HTMLElement>(".stl").forEach((el) => {
    el.querySelectorAll<HTMLButtonElement>(".stl-group").forEach((h) => {
      const g = h.dataset.group;
      const set = (open: boolean) => {
        h.setAttribute("aria-expanded", String(open));
        el.querySelectorAll<HTMLElement>(`[data-g="${g}"]`).forEach((n) => n.classList.toggle("stl-shut", !open));
      };
      set(false);
      h.addEventListener("click", () => set(h.getAttribute("aria-expanded") !== "true"));
    });
  });
  const root = document.querySelectorAll<HTMLElement>(".stl");
  root.forEach((el) => {
    const tracks = el.querySelectorAll<HTMLElement>(".stl-track");
    if (!("IntersectionObserver" in window)) return;
    el.classList.add("stl-js");
    const io = new IntersectionObserver((es) => { let k = 0; for (const e of es) if (e.isIntersecting) { (e.target as HTMLElement).style.setProperty("--b", `${Math.min(k++, 6) * 60}ms`); e.target.classList.add("stl-in"); io.unobserve(e.target); } }, { threshold: 0.1 });
    tracks.forEach((t) => io.observe(t));
  });
</script>
