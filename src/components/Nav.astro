---
import ThemeToggle from "./ThemeToggle";
import SolutionsMenu from "./SolutionsMenu.astro";

const links = [
  { href: "/parcours/", label: "Parcours", n: "01" },
  { href: "/projets/", label: "Projets", n: "02" },
  { href: "/competences/", label: "Compétences", n: "03" },
  { href: "/blog/", label: "Blog", n: "04" },
  { href: "/modes/", label: "Modes", n: "05" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="font-display text-[26px] font-medium italic leading-none text-[var(--fg)]" aria-label="Rudy Gault, accueil">rg.</a>

    <div class="hidden items-center gap-6 lg:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm transition-colors hover:text-[var(--fg)]"
          style={{ color: isActive(link.href) ? "var(--fg)" : "var(--fg-muted)" }}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          <span class="font-mono text-[11px] text-[var(--fg-muted)]">{link.n}</span> {link.label}
          {isActive(link.href) && <span class="ml-1 inline-block h-1.5 w-1.5 rounded-full bg-[var(--accent)] align-middle"></span>}
        </a>
      ))}
      <SolutionsMenu id="oss-d" variant="desktop" />
    </div>

    <div class="hidden items-center gap-2 lg:flex">
      <a href="/cv-rudy-gault.pdf?v=2" download="CV-Rudy-Gault.pdf" class="inline-flex min-h-[40px] items-center rounded-full border border-[var(--border)] px-4 text-sm text-[var(--fg)] transition-colors hover:border-[var(--fg)]">CV</a>
      <a href="mailto:contact@rudy-ops.fr" class="inline-flex min-h-[40px] items-center rounded-full bg-[var(--accent)] px-4 text-sm text-[var(--accent-fg)] transition-opacity hover:opacity-90">Me contacter</a>
      <ThemeToggle client:load />
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full text-[var(--fg)] [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </summary>
      <div class="absolute right-0 top-12 flex w-64 flex-col gap-1 rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-3 shadow-lg">
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2 text-sm"
            style={{ color: isActive(link.href) ? "var(--accent)" : "var(--fg-soft)" }}
          >
            <span class="font-mono text-[11px] text-[var(--fg-muted)]">{link.n}</span> {link.label}
          </a>
        ))}
        <SolutionsMenu id="oss-m" variant="mobile" />
        <a href="mailto:contact@rudy-ops.fr" class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--accent)]">Me contacter</a>
        <a href="/cv-rudy-gault.pdf?v=2" download="CV-Rudy-Gault.pdf" class="rounded-lg px-3 py-2 text-sm text-[var(--fg-soft)]">Télécharger mon CV</a>
        <div class="mt-1 border-t border-[var(--border)] px-3 pt-3">
          <ThemeToggle client:load />
        </div>
      </div>
    </details>
  </nav>
</header>
