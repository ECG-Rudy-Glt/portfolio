---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import ModeInit from "../components/ModeInit.astro";
import { ui, swapPath, type Lang } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: { datePublished: Date; keywords?: string[] };
  bare?: boolean;
  lang?: Lang;
  /** Chemin de la même page dans l'autre langue (sélecteur FR/EN et hreflang). */
  alt?: string;
}

const {
  lang = "fr",
  alt,
  title = ui[lang].defaultTitle,
  description = ui[lang].defaultDescription,
  image = lang === "en" ? "/og-accueil-en.png?v=3" : "/og-accueil.png?v=3",
  imageAlt,
  article,
  bare = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const absoluteImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
// Image de partage par défaut : capture 1200×630 de la page d'accueil.
const t = ui[lang];
const isDefaultImage = image.startsWith("/og-accueil");
const ogImageAlt = imageAlt ?? (isDefaultImage ? t.ogAlt : title);
const site = Astro.site ?? Astro.url.origin;
const altURL = alt ? new URL(alt, site).toString() : undefined;
const selfURL = canonicalURL.toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rudy Gault",
  url: (Astro.site ?? Astro.url.origin).toString(),
  image: new URL("/avatar.png", Astro.site ?? Astro.url.origin).toString(),
  jobTitle: t.jobTitle,
  email: "contact@rudy-ops.fr",
  worksFor: { "@type": "Organization", name: "Cloud Temple" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "SUPINFO" },
  sameAs: [
    "https://www.linkedin.com/in/rudy-gault/",
    "https://github.com/ECG-Rudy-Glt",
    "https://rudy-ops.fr",
  ],
};

const articleSchema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title.replace(/ - Rudy Gault$/, ""),
      description,
      datePublished: article.datePublished.toISOString(),
      dateModified: article.datePublished.toISOString(),
      inLanguage: lang === "en" ? "en" : "fr-FR",
      keywords: article.keywords?.join(", "),
      image: absoluteImage,
      mainEntityOfPage: canonicalURL.toString(),
      author: { "@type": "Person", name: "Rudy Gault", url: (Astro.site ?? Astro.url.origin).toString() },
    }
  : null;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#121310" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    {altURL && <link rel="alternate" hreflang={lang} href={selfURL} />}
    {altURL && <link rel="alternate" hreflang={lang === "en" ? "fr" : "en"} href={altURL} />}
    {altURL && <link rel="alternate" hreflang="x-default" href={lang === "en" ? altURL : selfURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
    <title>{title}</title>

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    {isDefaultImage && <meta property="og:image:type" content="image/png" />}
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={t.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <slot name="head" />
    <ModeInit />
    <script is:inline src="/oss-flag.js?v=1"></script>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--fg)]">
    {!bare && <Nav lang={lang} alt={alt} />}
    {bare ? <slot /> : (
    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-16">
      <slot />
    </main>)}
    <script is:inline define:vars={{ locale: t.dateLocale, en: lang === "en" }}>
      // Compteur de pages vues (sans cookie) : masqué si le total est indisponible.
      fetch("/stats.json", { cache: "no-store" }).then(function (r) { return r.ok ? r.json() : Promise.reject(); }).then(function (d) {
        if (typeof d.views !== "number") return;
        var since = new Date(d.since + "T00:00:00").toLocaleDateString(locale, { day: "numeric", month: "long", year: "numeric" });
        document.querySelectorAll("[data-views]").forEach(function (el) {
          el.textContent = en
            ? d.views.toLocaleString(locale) + " page view" + (d.views > 1 ? "s" : "") + " since " + since
            : d.views.toLocaleString(locale) + " page" + (d.views > 1 ? "s" : "") + " vue" + (d.views > 1 ? "s" : "") + " depuis le " + since;
          el.hidden = false;
        });
      }).catch(function () {});
    </script>
    <script>
      import "../scripts/mermaid-init.ts";
      import "../scripts/oss-menu.ts";
    </script>
    {!bare && (<footer class="mt-16 border-t border-[var(--border)]">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-sm sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
        <div class="flex flex-col gap-2">
          <a href={lang === "en" ? "/en/" : "/"} class="font-display text-2xl italic text-[var(--fg)]">rg.</a>
          <span class="text-[var(--fg-muted)]">{t.footer.served}</span>
          <span data-views hidden class="text-[var(--fg-muted)]"></span>
        </div>
        <div class="flex flex-col gap-2">
          <span class="eyebrow">{t.footer.browse}</span>
          <a href={lang === "en" ? "/en/parcours/" : "/parcours/"} class="hover:text-[var(--accent)]">{t.nav.journey}</a>
          <a href={lang === "en" ? "/en/projets/" : "/projets/"} class="hover:text-[var(--accent)]">{t.nav.projects}</a>
          <a href={lang === "en" ? "/en/competences/" : "/competences/"} class="hover:text-[var(--accent)]">{t.nav.skills}</a>
          <a href="/blog/" class="hover:text-[var(--accent)]">{t.nav.blog}</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="eyebrow">{t.footer.elsewhere}</span>
          <a href="https://github.com/ECG-Rudy-Glt" target="_blank" rel="noreferrer" class="hover:text-[var(--accent)]">GitHub</a>
          <a href="https://www.linkedin.com/in/rudy-gault/" target="_blank" rel="noreferrer" class="hover:text-[var(--accent)]">LinkedIn</a>
          <a href="https://rudy-ops.fr" target="_blank" rel="noreferrer" class="hover:text-[var(--accent)]">{t.footer.freelance}</a>
          <a href="https://homelab.gault-rudy.com/" class="hover:text-[var(--accent)]">{t.footer.tour}</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="eyebrow">{t.footer.contact}</span>
          <a href="mailto:contact@rudy-ops.fr" class="hover:text-[var(--accent)]">contact@rudy-ops.fr</a>
          <a href="/cv-rudy-gault.pdf?v=3" download="CV-Rudy-Gault.pdf" class="hover:text-[var(--accent)]">{t.cvFooter}</a>
          <span class="text-[var(--fg-muted)]">© {new Date().getFullYear()} Rudy Gault</span>
        </div>
      </div>
    </footer>)}
  </body>
</html>
