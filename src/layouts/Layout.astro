---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Rudy Gault - Portfolio",
  description = "Alternant infrastructure & développement - projets école, projets personnels et alternance.",
  image = "/avatar.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const absoluteImage = new URL(image, Astro.site ?? Astro.url.origin).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rudy Gault",
  url: (Astro.site ?? Astro.url.origin).toString(),
  image: new URL("/avatar.png", Astro.site ?? Astro.url.origin).toString(),
  jobTitle: "Alternant infrastructure & développement",
  email: "gault.rudy@gmail.com",
  worksFor: { "@type": "Organization", name: "Cloud Temple" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "SUPINFO" },
  sameAs: ["https://www.linkedin.com/in/rudy-gault/"],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/avatar.png" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = stored || (prefersDark ? "dark" : "light");
      if (theme !== "light") document.documentElement.classList.add(theme);
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--fg)]">
    <Nav />
    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>
    <script>
      import "../scripts/mermaid-init.ts";
    </script>
    <footer class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 border-t border-[var(--border)] px-4 py-8 text-sm text-[var(--fg-muted)] sm:px-6">
      <p>© {new Date().getFullYear()} Rudy Gault</p>
      <div class="flex items-center gap-4">
        <a
          href="mailto:gault.rudy@gmail.com"
          aria-label="Email"
          title="Email"
          class="transition-colors hover:text-[var(--accent)]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/rudy-gault/"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
          title="LinkedIn"
          class="transition-colors hover:text-[var(--accent)]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
            <rect x="2" y="9" width="4" height="12" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>
        <a
          href="https://github.com/ECG-Rudy-Glt"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
          title="GitHub"
          class="transition-colors hover:text-[var(--accent)]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
          </svg>
        </a>
      </div>
    </footer>
  </body>
</html>
