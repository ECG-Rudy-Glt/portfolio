---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import ModeInit from "../components/ModeInit.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: { datePublished: Date; keywords?: string[] };
  bare?: boolean;
}

const {
  title = "Rudy Gault - Portfolio",
  description = "Alternant infrastructure & développement - projets école, projets personnels et alternance.",
  image = "/avatar.png",
  article,
  bare = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const absoluteImage = new URL(image, Astro.site ?? Astro.url.origin).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rudy Gault",
  url: (Astro.site ?? Astro.url.origin).toString(),
  image: new URL("/avatar.png", Astro.site ?? Astro.url.origin).toString(),
  jobTitle: "Alternant infrastructure & développement",
  email: "contact@rudy-ops.fr",
  worksFor: { "@type": "Organization", name: "Cloud Temple" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "SUPINFO" },
  sameAs: [
    "https://www.linkedin.com/in/rudy-gault/",
    "https://github.com/ECG-Rudy-Glt",
    "https://rudy-ops.fr",
  ],
};

const articleSchema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title.replace(/ - Rudy Gault$/, ""),
      description,
      datePublished: article.datePublished.toISOString(),
      dateModified: article.datePublished.toISOString(),
      inLanguage: "fr-FR",
      keywords: article.keywords?.join(", "),
      image: absoluteImage,
      mainEntityOfPage: canonicalURL.toString(),
      author: { "@type": "Person", name: "Rudy Gault", url: (Astro.site ?? Astro.url.origin).toString() },
    }
  : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/avatar.png" />
    <title>{title}</title>

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <slot name="head" />
    <ModeInit />
    <script is:inline src="/oss-flag.js?v=1"></script>
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = stored || (prefersDark ? "dark" : "light");
      if (theme !== "light") document.documentElement.classList.add(theme);
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--fg)]">
    {!bare && <Nav />}
    {bare ? <slot /> : (
    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-16">
      <slot />
    </main>)}
    <script is:inline>
      // Compteur de pages vues (sans cookie) : masqué si le total est indisponible.
      fetch("/stats.json", { cache: "no-store" }).then(function (r) { return r.ok ? r.json() : Promise.reject(); }).then(function (d) {
        if (typeof d.views !== "number") return;
        var since = new Date(d.since + "T00:00:00").toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
        document.querySelectorAll("[data-views]").forEach(function (el) {
          el.textContent = d.views.toLocaleString("fr-FR") + " page" + (d.views > 1 ? "s" : "") + " vue" + (d.views > 1 ? "s" : "") + " depuis le " + since;
          el.hidden = false;
        });
      }).catch(function () {});
    </script>
    <script>
      import "../scripts/mermaid-init.ts";
      import "../scripts/oss-menu.ts";
    </script>
    {!bare && (<footer class="mt-16 border-t border-[var(--border)]">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-sm sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
        <div class="flex flex-col gap-2">
          <a href="/" class="font-display text-2xl italic text-[var(--fg)]">rg.</a>
          <span class="text-[var(--fg-muted)]">Servi depuis mon homelab : nginx dans un conteneur sur Proxmox.</span>
          <span data-views hidden class="text-[var(--fg-muted)]"></span>
        </div>
        <div class="flex flex-col gap-2">
          <span class="eyebrow">Naviguer</span>
          <a href="/parcours/" class="hover:text-[var(--accent)]">Parcours</a>
          <a href="/projets/" class="hover:text-[var(--accent)]">Projets</a>
          <a href="/competences/" class="hover:text-[var(--accent)]">Compétences</a>
          <a href="/blog/" class="hover:text-[var(--accent)]">Blog</a>
          <a href="/modes/" class="hover:text-[var(--accent)]">Modes</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="eyebrow">Ailleurs</span>
          <a href="https://github.com/ECG-Rudy-Glt" target="_blank" rel="noreferrer" class="hover:text-[var(--accent)]">GitHub</a>
          <a href="https://www.linkedin.com/in/rudy-gault/" target="_blank" rel="noreferrer" class="hover:text-[var(--accent)]">LinkedIn</a>
          <a href="https://rudy-ops.fr" target="_blank" rel="noreferrer" class="hover:text-[var(--accent)]">rudy-ops.fr (freelance)</a>
          <a href="https://homelab.gault-rudy.com/" class="hover:text-[var(--accent)]">Visite du homelab</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="eyebrow">Contact</span>
          <a href="mailto:contact@rudy-ops.fr" class="hover:text-[var(--accent)]">contact@rudy-ops.fr</a>
          <a href="/cv-rudy-gault.pdf?v=2" download="CV-Rudy-Gault.pdf" class="hover:text-[var(--accent)]">CV (PDF)</a>
          <span class="text-[var(--fg-muted)]">© {new Date().getFullYear()} Rudy Gault</span>
        </div>
      </div>
    </footer>)}
  </body>
</html>
